# Obsidian OS Plymouth script theme
# Logo is rasterized from the repository SVG during image build.
logo.image = Image("obsidian-logo.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(Window.GetWidth() / 2 - logo.image.GetWidth() / 2);
logo.sprite.SetY(Window.GetHeight() / 2 - logo.image.GetHeight() / 2 - 70);
status.image = Image.Text("Carregando o sistema...", 0.85, 0.75, 0.95);
status.sprite = Sprite(status.image);
status.sprite.SetX(Window.GetWidth() / 2 - status.image.GetWidth() / 2);
status.sprite.SetY(Window.GetHeight() * 0.72);
