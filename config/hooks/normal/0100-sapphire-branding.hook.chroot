#!/bin/sh
set -eu
THEME_DIR=/usr/share/plymouth/themes/sapphire
mkdir -p "$THEME_DIR"
if command -v rsvg-convert >/dev/null 2>&1; then
  rsvg-convert -w 320 -h 320 /usr/share/sapphire/branding/sapphire-logo.svg -o "$THEME_DIR/sapphire-logo.png"
fi
if [ -f "$THEME_DIR/sapphire-logo.png" ]; then
  if command -v plymouth-set-default-theme >/dev/null 2>&1; then plymouth-set-default-theme sapphire; fi
  if command -v update-initramfs >/dev/null 2>&1; then update-initramfs -u; fi
fi
exit 0
